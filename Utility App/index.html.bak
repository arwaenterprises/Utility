                <div id="scannerScanScreen" class="scanner-screen">
                    <div class="info-bar">
                        <span id="lblStore">Store:</span> <span id="dispScannerStore">-</span> | 
                        <span id="lblStaff">Staff:</span> <span id="dispScannerStaff">-</span>
